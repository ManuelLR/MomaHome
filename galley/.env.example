# Domain configuration
EXTERNAL_WILDCARD_DOMAIN=*.example.com
# Current domain, reachable from the internet.
GALLEY_EXTERNAL_DOMAIN=galley.example.com
# Previous domain. Kept LAN-only and redirected to the one above; drop the
# `galley-legacy` router (and this var) once nobody uses the old URL.
GALLEY_LEGACY_DOMAIN=galley.old-example.com
