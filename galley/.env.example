# Domain configuration
EXTERNAL_WILDCARD_DOMAIN=*.example.com
GALLEY_EXTERNAL_DOMAIN=galley.example.com

# Origins allowed to embed galley in an iframe (CSP frame-ancestors).
# Space-separated, each with scheme; keep it to the few hosts that need it,
# e.g. galley itself plus Home Assistant. Include 'self' if galley frames itself.
GALLEY_FRAME_ANCESTORS=https://galley.example.com https://ha.example.com
