# Copy to .env and adjust. Read by docker compose, backup.sh and install.sh.

# rclone remote and path holding the restic repository. Pick a neutral folder
# name that says neither "backup" nor the tool, and keep the real one out of
# the repository.
RESTIC_REPOSITORY=rclone:o2:some-neutral-name

# Host name recorded in every snapshot. Retention groups snapshots by it, so it
# must stay the same across runs (the container's own hostname is random).
RESTIC_HOST=myserver

# Host directory for the repository key and the rclone session (restic-password,
# rclone.conf). Outside this checkout, like the other apps' data, so copying or
# sharing the repository never takes them along. backup.sh excludes it.
SECRETS_DIR=/srv/data/restic-offsite/secrets

# Host directory for restic's local cache. Keep it outside the backed-up paths.
CACHE_DIR=/var/cache/restic-offsite

# Paths to back up. docker-compose.yml mounts each one read-only at the same
# path, and backup.sh backs up exactly these.
BACKUP_SRC_DATA=/srv/data
BACKUP_SRC_HOME=/home/user
BACKUP_SRC_DOCKER_VOLUMES=/srv/docker/volumes

# Where failure notices go (sent with msmtp).
MAIL_TO=you@example.com

# When cron runs backup.sh (install.sh writes it to /etc/cron.d/restic-o2).
CRON_SCHEDULE="30 3 * * *"

# One log file per run; files older than 90 days are deleted.
LOG_DIR=/var/log/restic-offsite

# A run still going after this many hours is treated as stuck: every later
# night mails a warning instead of just skipping. The first full upload takes
# a couple of days, so leave room for it.
STUCK_AFTER_HOURS=96

# Time zone for snapshot times in the logs.
TZ=UTC

# Retention, applied by backup.sh on Sundays.
KEEP_DAILY=30
KEEP_WEEKLY=26
KEEP_MONTHLY=36
KEEP_YEARLY=unlimited

# Unused space prune may leave in the repository before it repacks. Repacking
# downloads and re-uploads data, and uploads to O2 are slow (~5 MiB/s), so with
# plenty of quota it pays to tolerate more waste than restic's default 5%.
PRUNE_MAX_UNUSED=15%

# Any other RCLONE_* or RESTIC_* variable set here reaches the container as is
# (quote values with spaces: backup.sh and install.sh source it with bash).
