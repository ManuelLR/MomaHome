// File: .github/renovate.json5
// This file contains the REPOSITORY-LEVEL configuration for Renovate.
// It defines WHAT Renovate should do within this specific project.
// Global/operational settings are in .github/renovate.global.js

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  
  // Branch configuration
  branchPrefix: 'renovate_cron/',
  baseBranchPatterns: [
    'next'
  ],
  
  // PR metadata
  assignees: [
    'ManuelLR'
  ],
  reviewers: [
    'ManuelLR'
  ],
  labels: [
    'dependency-update'
  ],
  
  // Package-specific rules
  packageRules: [
    {
      // Disable auto-detected traefik because they publish containers before stable version
      matchPackageNames: [
        'traefik'
      ],
      matchDatasources: [
        'docker'
      ],
      enabled: false
    }
  ],
  
  // Custom managers for specific dependency patterns
  customManagers: [
    {
      // Custom regex manager for Dockerfile ARG variables
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/|\\.)Dockerfile$/',
        '/(^|/)Dockerfile\\.[^/]*$/'
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?( versioning=(?<versioning>.*?))?(\\s|\\n).*?_VERSION=(?<currentValue>[^ ]*)( \\\\|\\s|\\n)'
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}'
    },
    {
      // Generic comment-based manager for docker-compose images that Renovate
      // can't auto-resolve to a source repo (so PRs get changelog/release notes).
      // Annotate the image with a comment on the line above, e.g.:
      //   # renovatebot: datasource=github-releases depName=owner/Repo [packageName=...] [registryUrl=https://codeberg.org] [versioning=semver] [extractVersion=^v(?<version>.+)$]
      //   image: owner/image:1.2.3
      // Keep the fields in that order. registryUrl is needed e.g. for gitea-releases (Codeberg).
      // Defaults: versioning=semver-coerced, extractVersion strips an optional leading 'v'.
      // No need to disable the built-in docker manager: Renovate dedupes updates
      // that touch the same file line (same as the traefik/calibre setups).
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)docker-compose\\.ya?ml$/'
      ],
      matchStrings: [
        '# renovate(?:bot)?: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?: (?:packageName|lookupName)=(?<packageName>\\S+?))?(?: registryUrl=(?<registryUrl>\\S+?))?(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s*?\\n\\s*image: [^\\s:]+:(?<currentValue>[^\\s@]+)'
      ],
      datasourceTemplate: '{{{datasource}}}',
      depNameTemplate: '{{{depName}}}',
      packageNameTemplate: '{{#if packageName}}{{{packageName}}}{{else}}{{{depName}}}{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
      extractVersionTemplate: '{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}'
    },
    {
      // Custom regex for Traefik (using GitHub releases instead of Docker)
      customType: 'regex',
      managerFilePatterns: [
        '/reverse-proxy/docker-compose.yml/'
      ],
      matchStrings: [
        'image: traefik:(?<currentValue>[^ ]*)\\n'
      ],
      depNameTemplate: 'traefik/traefik',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'docker'
    },
    {
      // Custom regex for Calibre Web (not auto-detected)
      customType: 'regex',
      managerFilePatterns: [
        '/reading/docker-compose.yml/'
      ],
      matchStrings: [
        'image: ghcr.io/crocodilestick/calibre-web-automated:(?<currentValue>[^ ]*)\\n'
      ],
      depNameTemplate: 'crocodilestick/calibre-web-automated',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver-coerced'
    },
    {
      // Update version variables in GitHub workflows
      customType: 'regex',
      description: [
        'Update `version:` and `_VERSION:` variables in github workflows'
      ],
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/'
      ],
      matchStrings: [
        '\\s+(?:[a-z]-)?version: (?<currentValue>.+?) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: (?:packageName|lookupName)=(?<packageName>.+?))?(?: versioning=(?<versioning>.+?))?\\s',
        '\\s*[A-Z_]+?_VERSION: (?<currentValue>.+?) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)(?: (?:packageName|lookupName)=(?<packageName>.+?))?(?: versioning=(?<versioning>.+?))?\\s'
      ]
    }
  ]
}
