# Shared domain configuration (under your deSEC wildcard)
EXTERNAL_WILDCARD_DOMAIN=*.example.com

# --- IMMICH ---
# Access subdomain (LAN-only via Traefik; from outside home use WireGuard).
IMMICH_EXTERNAL_DOMAIN=fotos.example.com

# Postgres password. Use ONLY A-Za-z0-9 characters (no symbols/spaces).
# Generate it once and keep it:  openssl rand -hex 24
DB_PASSWORD=

# Internal DB identifiers. Normally left as-is.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Timezone for logs, jobs and EXIF dates without an offset.
TZ=Europe/Madrid
