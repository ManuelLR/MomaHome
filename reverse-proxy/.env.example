TRAEFIK_CERTIFICATESRESOLVERS_PRINCIPAL_ACME_EMAIL=you@example.com
# Shared domain configuration (under your deSEC wildcard)
EXTERNAL_WILDCARD_DOMAIN=*.example.com
DESEC_TOKEN=
DUCKDNS_TOKEN=

# CrowdSec state: seeded config, machine credentials, LAPI database, hub
CROWDSEC_CONFIG_DIR=/data/crowdsec/config
CROWDSEC_DATA_DIR=/data/crowdsec/data

# Traefik bouncer key, registered in CrowdSec: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# Same id as crowdsec_webhook_id in Home Assistant's secrets.yaml
HA_CROWDSEC_WEBHOOK_URL=http://host.docker.internal:8123/api/webhook/<crowdsec_webhook_id>

# CrowdSec web UI (crowdsec-ui). LAN/WireGuard only, permanently.
CROWDSEC_UI_EXTERNAL_DOMAIN=crowdsec.example.com
CROWDSEC_UI_DATA_DIR=/data/crowdsec/ui
# Password of the `crowdsec-web-ui` machine in CrowdSec: openssl rand -hex 32
CROWDSEC_UI_MACHINE_PASSWORD=
