# Host logrotate config for Traefik's access log (tmpfs, read by CrowdSec).
# Install: sudo cp reverse-proxy/logrotate/traefik-access /etc/logrotate.d/
# Test:    sudo logrotate --debug /etc/logrotate.d/traefik-access
#
# Traefik reopens the file on USR1; CrowdSec follows the new one by itself.
# `size` is only checked when logrotate runs (daily by default): see
# crowdsec/README.md to run it hourly.
/run/momahome/traefik-logs/access.log {
  size 20M
  rotate 1
  missingok
  notifempty
  nocompress
  postrotate
    docker kill --signal=USR1 reverse-proxy_traefik > /dev/null 2>&1 || true
  endscript
}
