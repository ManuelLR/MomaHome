# Hub update every 12 h (the Linux packages do it daily): new rules
# (CVE scenarios, virtual patching) are installed and CrowdSec reloads (SIGHUP
# to PID 1) only if something changed. Run by busybox crond, see docker-compose.yml.
17 4,16 * * * cscli --error hub update && u="$(cscli --error hub upgrade)" && [ -n "$u" ] && echo "hub upgraded: $u" > /proc/1/fd/1 && kill -HUP 1
