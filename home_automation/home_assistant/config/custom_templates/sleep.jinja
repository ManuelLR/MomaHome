{#- Hours between `since` (UNIX timestamp) and now, NOT counting the nights (everybody
    asleep, packages/sleep): the recorded nights in sensor.sleep_last_night (attribute
    `nights`: [[start_ts, end_ts], ...]) plus the current one if input_boolean.sleep_night
    is on. E.g. a pee at 22:00 is not "10 hours ago" at 08:00 (packages/dog).
    Returns 0 if `since` is not valid.
    Usage: {% from 'sleep.jinja' import awake_hours %}{{ awake_hours(ts) | float }} -#}
{%- macro awake_hours(since) -%}
{%- set t0 = since | float(0) -%}
{%- set t1 = as_timestamp(now()) -%}
{%- if t0 <= 0 or t0 >= t1 -%}0
{%- else -%}
{%- set nights = state_attr('sensor.sleep_last_night', 'nights') or [] -%}
{%- if is_state('input_boolean.sleep_night', 'on') -%}
{%- set nights = nights + [[state_attr('input_datetime.sleep_started_at', 'timestamp') | float(t1), t1]] -%}
{%- endif -%}
{%- set ns = namespace(quiet=0) -%}
{%- for n in nights -%}
{%- set ns.quiet = ns.quiet + ([[n[1] | float(0), t1] | min - [n[0] | float(0), t0] | max, 0] | max) -%}
{%- endfor -%}
{{- (([t1 - t0 - ns.quiet, 0] | max) / 3600) | round(2) -}}
{%- endif -%}
{%- endmacro -%}
