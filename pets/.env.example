# Shared domain configuration (under your deSEC wildcard)
EXTERNAL_WILDCARD_DOMAIN=*.example.com

# --- EinVault ---
EINVAULT_EXTERNAL_DOMAIN=pets.example.com

# Maximum image/document upload size in MB.
EINVAULT_UPLOAD_MAX_MB=10

# Optional: Immich (journal photos and avatars by reference). Same Docker network,
# so the internal URL works. Create a read-only API key in Immich. Leave empty to
# disable.
#   EINVAULT_IMMICH_URL=http://immich-server:2283
EINVAULT_IMMICH_URL=
EINVAULT_IMMICH_API_KEY=

# Optional: ntfy server for reminder push notifications. Leave empty to disable.
#   EINVAULT_NTFY_URL=https://ntfy.sh
EINVAULT_NTFY_URL=
EINVAULT_NTFY_TOKEN=

# --- Shared ---
# Timezone for dates, reminders and notifications.
TZ=Europe/Madrid
