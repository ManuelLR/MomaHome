# Shared domain configuration (under your deSEC wildcard)
EXTERNAL_WILDCARD_DOMAIN=*.example.com

# Domain where the site is served
NATURALEANDO_EXTERNAL_DOMAIN=naturaleando.example.com

# Host folder with the built site (contents of `dist/`). Optional.
# NATURALEANDO_DIST_PATH=/data/naturaleando/dist

# Timezone for logs
TZ=Europe/Madrid
